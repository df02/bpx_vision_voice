<?xml version="1.0"?>
<!--
  Black Panther X (BPX) quadruped description.

  Joint names and ordering match bpx_sdk_open/include/motion_types.h
  (mirrormerobotics/bpx_sdk_open) JointIndex enum:

    0 fl_hip_roll_joint   1 fl_hip_pitch_joint   2 fl_knee_joint
    3 fr_hip_roll_joint   4 fr_hip_pitch_joint   5 fr_knee_joint
    6 hl_hip_roll_joint   7 hl_hip_pitch_joint   8 hl_knee_joint
    9 hr_hip_roll_joint  10 hr_hip_pitch_joint  11 hr_knee_joint

  Kinematic offsets, axes, and limits are PLACEHOLDERS — replace with
  values from the MirrorMe CAD/datasheets when available.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bpx">

  <xacro:arg name="use_sim" default="false"/>

  <!-- ===================== Body ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.18 0.10"/>
      </geometry>
      <material name="body_grey">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.12" iyz="0" izz="0.14"/>
    </inertial>
  </link>

  <!-- ============ Perception head (Insight 9) ============ -->
  <!-- Placeholder mount: front-top of body, angled down ~10 deg. -->
  <link name="insight9_mount"/>
  <joint name="insight9_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="insight9_mount"/>
    <origin xyz="0.20 0.0 0.06" rpy="0 -0.1745 0"/>
  </joint>

  <link name="insight9_camera_link">
    <visual>
      <geometry>
        <box size="0.129 0.035 0.035"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.176"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>
  <joint name="insight9_camera_joint" type="fixed">
    <parent link="insight9_mount"/>
    <child link="insight9_camera_link"/>
    <!-- Looper Insight 9: lens is offset along the 129 mm body. -->
    <origin xyz="0.03 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame: +Z forward, +X right, +Y down (ROS convention). -->
  <link name="insight9_camera_optical"/>
  <joint name="insight9_camera_optical_joint" type="fixed">
    <parent link="insight9_camera_link"/>
    <child link="insight9_camera_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ===================== Legs ===================== -->
  <xacro:macro name="leg" params="prefix x_offset y_offset">
    <link name="${prefix}_hip_roll_link">
      <visual>
        <geometry><box size="0.06 0.06 0.06"/></geometry>
        <material name="body_grey"/>
      </visual>
      <inertial>
        <mass value="0.4"/>
        <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
      </inertial>
    </link>
    <joint name="${prefix}_hip_roll_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_hip_roll_link"/>
      <!-- TODO(calibration): axis and origin from MirrorMe CAD. -->
      <origin xyz="${x_offset} ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.8" upper="0.8" effort="60.0" velocity="20.0"/>
    </joint>

    <link name="${prefix}_thigh_link">
      <visual>
        <origin xyz="0 0 -0.09"/>
        <geometry><box size="0.05 0.05 0.18"/></geometry>
        <material name="body_grey"/>
      </visual>
      <inertial>
        <origin xyz="0 0 -0.09"/>
        <mass value="0.6"/>
        <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0008"/>
      </inertial>
    </link>
    <joint name="${prefix}_hip_pitch_joint" type="revolute">
      <parent link="${prefix}_hip_roll_link"/>
      <child link="${prefix}_thigh_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.6" upper="1.6" effort="60.0" velocity="20.0"/>
    </joint>

    <link name="${prefix}_shank_link">
      <visual>
        <origin xyz="0 0 -0.10"/>
        <geometry><box size="0.04 0.04 0.20"/></geometry>
        <material name="body_grey"/>
      </visual>
      <inertial>
        <origin xyz="0 0 -0.10"/>
        <mass value="0.3"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0004"/>
      </inertial>
    </link>
    <joint name="${prefix}_knee_joint" type="revolute">
      <parent link="${prefix}_thigh_link"/>
      <child link="${prefix}_shank_link"/>
      <origin xyz="0 0 -0.18" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.2" upper="0.3" effort="60.0" velocity="20.0"/>
    </joint>

    <link name="${prefix}_foot">
      <visual>
        <geometry><sphere radius="0.02"/></geometry>
        <material name="foot_black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>
    <joint name="${prefix}_foot_joint" type="fixed">
      <parent link="${prefix}_shank_link"/>
      <child link="${prefix}_foot"/>
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:leg prefix="fl" x_offset="0.17" y_offset="0.10"/>
  <xacro:leg prefix="fr" x_offset="0.17" y_offset="-0.10"/>
  <xacro:leg prefix="hl" x_offset="-0.17" y_offset="0.10"/>
  <xacro:leg prefix="hr" x_offset="-0.17" y_offset="-0.10"/>

</robot>
